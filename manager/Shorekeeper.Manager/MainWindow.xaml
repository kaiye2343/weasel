<Window x:Class="Shorekeeper.Manager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小狼毫 · 皮肤与输入设置" Width="1120" Height="820" MinWidth="920" MinHeight="660">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock FontSize="27" FontWeight="SemiBold" Text="让输入更合心意"/><TextBlock Margin="0,8,0,0" Foreground="#60778D" Text="导入皮肤、调整外观与管理个人输入。面板关闭后，皮肤仍由小狼毫绘制。"/></StackPanel>
  <TabControl Grid.Row="1" Background="White" BorderBrush="#D8E5F0">
   <TabItem Header="皮肤"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="导入 .rimeskin / ZIP" Click="ImportSkin"/><Button Content="恢复默认外观" Click="ResetSkin"/></StackPanel><ListBox x:Name="SkinList" SelectionChanged="SkinChanged" DisplayMemberPath="Display" BorderBrush="#D8E5F0"/></DockPanel>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="SkinName" Text="选择或导入一个皮肤" FontSize="22" FontWeight="SemiBold"/>
     <Image x:Name="Thumbnail" Height="150" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,10"/>
     <TextBlock Text="角色 / 变体"/><ComboBox x:Name="VariantList" DisplayMemberPath="Name" SelectionChanged="VariantChanged"/>
     <WrapPanel><Button Content="打开原生预览" Click="PreviewSkin"/><Button Content="启用并即时刷新" Background="#DCEEFF" Click="ApplySkin"/><Button Content="导出皮肤包" Click="ExportSkin"/></WrapPanel>
     <TextBlock Margin="0,12,0,0" Text="样式参数" FontSize="17" FontWeight="SemiBold"/>
     <UniformGrid Columns="2" Margin="0,10,0,0">
      <StackPanel><TextBlock Text="候选字号"/><TextBox x:Name="FontSizeInput" Text="16"/></StackPanel>
      <StackPanel><TextBlock Text="右侧角色留白"/><TextBox x:Name="RightPadding" Text="16"/></StackPanel>
      <StackPanel><TextBlock Text="候选注音位置"/><ComboBox x:Name="AnnotationPosition" SelectedIndex="1"><ComboBoxItem Content="汉字上方"/><ComboBoxItem Content="汉字旁边"/><ComboBoxItem Content="隐藏"/></ComboBox></StackPanel>
      <StackPanel><TextBlock Text="边框样式"/><ComboBox x:Name="BorderKind" SelectedIndex="1"><ComboBoxItem Content="无边框"/><ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/></ComboBox></StackPanel>
     </UniformGrid>
     <TextBlock Text="注音使用方案提供的整条候选注释；没有注释的候选留空。" TextWrapping="Wrap" Foreground="#60778D" Margin="0,10"/>
     <Expander Header="高级样式参数"><TextBox x:Name="StyleEditor" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Height="235" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Expander>
    </StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="输入与场景"><ScrollViewer><StackPanel Margin="22">
    <TextBlock Text="配置目录" FontWeight="SemiBold"/><TextBox x:Name="RimeDirectory"/>
    <TextBlock Text="当前场景（标识仅使用英文、数字或下划线）"/><TextBox x:Name="ProfileId" Text="daily"/>
    <WrapPanel><Button Content="载入场景设置" Click="LoadInputSettings"/><Button Content="新建独立学习场景" Click="CreateProfile"/></WrapPanel>
    <TextBlock Text="拼音方案"/><ComboBox x:Name="InputMode"/>
    <WrapPanel Margin="0,8"><CheckBox x:Name="SimplifiedInput" Content="默认简体" Margin="0,0,24,0"/><CheckBox x:Name="CorrectionInput" Content="拼写纠错" Margin="0,0,24,0"/><CheckBox x:Name="ContextInput" Content="上下文排序"/></WrapPanel>
    <TextBlock Text="模糊音（按需开启，避免无关候选过多）"/><WrapPanel x:Name="FuzzyOptions"/>
    <TextBlock Text="快捷短语：每行一个缩写，按 Tab 键分隔短语"/><TextBox x:Name="ShortcutsInput" AcceptsReturn="True" AcceptsTab="True" Height="100" VerticalScrollBarVisibility="Auto"/>
    <Expander Header="高级输入参数"><TextBox x:Name="InputEditor" AcceptsReturn="True" Height="220" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></Expander>
    <WrapPanel><Button Content="备份并应用输入设置" Click="SaveInputSettings"/><Button Content="导入自定义词库" Click="ImportDictionary"/><Button Content="备份场景资料" Click="BackupProfile"/><Button Content="恢复备份" Click="RestoreProfile"/></WrapPanel>
    <TextBlock Text="输入设置修改后需要部署；外观切换不需要。计算、日期、金额和特殊符号继续由万象提供。" TextWrapping="Wrap" Foreground="#60778D"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="同步"><StackPanel Margin="22">
    <TextBlock Text="手动 WebDAV 同步" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="只传输官方同步快照，再由 Rime 合并。首次连接前请确认服务器地址与授权。" Margin="0,10" TextWrapping="Wrap"/>
    <TextBlock Text="WebDAV 地址（HTTPS）"/><TextBox x:Name="DavUrl" Text="https://dav.jianguoyun.com/dav/"/>
    <TextBlock Text="账号"/><TextBox x:Name="DavUser"/>
    <TextBlock Text="应用密码"/><PasswordBox x:Name="DavPassword" Padding="9" Margin="0,4,12,12"/>
    <CheckBox x:Name="RememberCredential" Content="使用 Windows 凭据管理器保存应用密码" Margin="0,0,0,16"/>
    <Button Content="连接并执行手动同步" Click="SyncNow" HorizontalAlignment="Left"/>
    <TextBlock Text="顺序：备份本地快照 → 下载各设备快照 → 官方合并 → 上传本机快照。关闭面板即结束，不启用自动常驻同步。" TextWrapping="Wrap" Foreground="#60778D"/>
   </StackPanel></TabItem>
   <TabItem Header="诊断"><StackPanel Margin="22"><TextBlock Text="问题1：先保存现场，再恢复" FontSize="21" FontWeight="SemiBold"/><TextBlock Margin="0,10,0,20" TextWrapping="Wrap" Text="收集配置来源、进程版本、运行日志和文件哈希，不记录当前输入内容。诊断动作不会重启服务。"/><Button Content="保存诊断包" Click="CollectDiagnostics" HorizontalAlignment="Left"/><TextBlock x:Name="DiagnosticResult" TextWrapping="Wrap"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#466985"/>
 </Grid>
</Window>
