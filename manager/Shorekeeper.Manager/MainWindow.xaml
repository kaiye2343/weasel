<Window x:Class="Shorekeeper.Manager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rime 设置中心" Width="1320" Height="900" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#ECEFF3" CornerRadius="14" Padding="12"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="12,16,0,24"><TextBlock Text="Rime" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="设置中心" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="Windows · Rime / 小狼毫" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,18"/>
   <ListBox x:Name="Navigation" SelectionChanged="Navigate" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0"/>
  </DockPanel></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="2,8,0,20"><TextBlock x:Name="TitleText" Text="通用与候选显示" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Foreground="{StaticResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
   <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><TextBlock Text="配置目录" Foreground="{StaticResource Muted}" FontSize="12"/><TextBox x:Name="RimeDirectory" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="作用范围" Foreground="{StaticResource Muted}" FontSize="12"/><ComboBox x:Name="ScopeSelector" DisplayMemberPath="Name" SelectionChanged="ChangeScope" Margin="0,6,0,0"/></StackPanel>
     <Button Grid.Column="2" Content="载入" Click="LoadSettings" VerticalAlignment="Bottom" Margin="0"/>
    </Grid>
   </Border>
   <ContentControl Grid.Row="2" x:Name="PageHost"/>
   <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SaveState" Text="已载入 · 未修改" FontWeight="SemiBold" Foreground="#28704D"/><TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,10,0" TextWrapping="Wrap"/></StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="PreviewButton" Content="预览修改" Click="PreviewChanges"/><Button x:Name="SaveButton" Content="保存设置" Click="SaveSettings" Style="{StaticResource AccentButton}"/><Button Content="部署应用" Click="Deploy" Margin="0"/></WrapPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
